(version 1)
# Generated by hwde rules_gen.py from constraints + jlc_capabilities.
# Baseline (fab floor) first, per-net design rules last (later rule wins).
(rule "aiee_track_width_floor"
	(constraint track_width (min 0.1016mm))
	(condition "A.Type == 'track'")
)
(rule "aiee_clearance_floor"
	(constraint clearance (min 0.1016mm))
)
(rule "aiee_via_drill_floor"
	(constraint hole_size (min 0.2000mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_via_diameter_floor"
	(constraint via_diameter (min 0.4500mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_annular_floor"
	(constraint annular_width (min 0.1000mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_edge_clearance_floor"
	(constraint edge_clearance (min 0.3000mm))
)
(rule "aiee_hole_to_hole_floor"
	(constraint hole_to_hole (min 0.5000mm))
)
(rule "aiee_silk_width_floor"
	(constraint text_thickness (min 0.1500mm))
	(condition "A.Type == 'text' && (A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen')")
)
(rule "aiee_pwr_width_VBUS_IN"
	(constraint track_width (min 0.2500mm))
	(condition "A.NetName == 'VBUS_IN' && A.Type == 'track'")
)
(rule "aiee_pwr_width_VBUS"
	(constraint track_width (min 0.2500mm))
	(condition "A.NetName == 'VBUS' && A.Type == 'track'")
)
(rule "aiee_pwr_width_PVDD"
	(constraint track_width (min 0.2500mm))
	(condition "A.NetName == 'PVDD' && A.Type == 'track'")
)
(rule "aiee_pwr_width_5V"
	(constraint track_width (min 0.2500mm))
	(condition "A.NetName == '+5V' && A.Type == 'track'")
)
(rule "aiee_pwr_width_3V3"
	(constraint track_width (min 0.1500mm))
	(condition "A.NetName == '+3V3' && A.Type == 'track'")
)
(rule "aiee_pwr_width_3V3A"
	(constraint track_width (min 0.0500mm))
	(condition "A.NetName == '+3V3A' && A.Type == 'track'")
)
(rule "aiee_pwr_width_5VA"
	(constraint track_width (min 0.0250mm))
	(condition "A.NetName == '+5VA' && A.Type == 'track'")
)
(rule "aiee_pwr_width_3V3E"
	(constraint track_width (min 0.0500mm))
	(condition "A.NetName == '+3V3E' && A.Type == 'track'")
)
(rule "aiee_pwr_width_amp_a_A_OUT1M"
	(constraint track_width (min 0.1843mm))
	(condition "A.NetName == '/amp_a/A_OUT1M' && A.Type == 'track'")
)
(rule "aiee_pwr_width_amp_a_A_OUT1P"
	(constraint track_width (min 0.1843mm))
	(condition "A.NetName == '/amp_a/A_OUT1P' && A.Type == 'track'")
)
(rule "aiee_pwr_width_amp_a_A_OUT2M"
	(constraint track_width (min 0.1843mm))
	(condition "A.NetName == '/amp_a/A_OUT2M' && A.Type == 'track'")
)
(rule "aiee_pwr_width_amp_a_A_OUT2P"
	(constraint track_width (min 0.1843mm))
	(condition "A.NetName == '/amp_a/A_OUT2P' && A.Type == 'track'")
)
(rule "aiee_pwr_width_amp_a_A_SPK_L"
	(constraint track_width (min 0.1843mm))
	(condition "A.NetName == '/A_SPK_L+' && A.Type == 'track'")
)
(rule "aiee_pwr_width_amp_a_A_SPK_L"
	(constraint track_width (min 0.1843mm))
	(condition "A.NetName == '/amp_a/A_SPK_L-' && A.Type == 'track'")
)
(rule "aiee_pwr_width_amp_a_A_SPK_R"
	(constraint track_width (min 0.1843mm))
	(condition "A.NetName == '/A_SPK_R+' && A.Type == 'track'")
)
(rule "aiee_pwr_width_amp_a_A_SPK_R"
	(constraint track_width (min 0.1843mm))
	(condition "A.NetName == '/amp_a/A_SPK_R-' && A.Type == 'track'")
)
(rule "aiee_pwr_width_amp_b_B_OUT1M"
	(constraint track_width (min 0.1843mm))
	(condition "A.NetName == '/amp_b/B_OUT1M' && A.Type == 'track'")
)
(rule "aiee_pwr_width_amp_b_B_OUT1P"
	(constraint track_width (min 0.1843mm))
	(condition "A.NetName == '/amp_b/B_OUT1P' && A.Type == 'track'")
)
(rule "aiee_pwr_width_amp_b_B_OUT2M"
	(constraint track_width (min 0.1843mm))
	(condition "A.NetName == '/amp_b/B_OUT2M' && A.Type == 'track'")
)
(rule "aiee_pwr_width_amp_b_B_OUT2P"
	(constraint track_width (min 0.1843mm))
	(condition "A.NetName == '/amp_b/B_OUT2P' && A.Type == 'track'")
)
(rule "aiee_pwr_width_amp_b_B_SPK_L"
	(constraint track_width (min 0.1843mm))
	(condition "A.NetName == '/amp_b/B_SPK_L+' && A.Type == 'track'")
)
(rule "aiee_pwr_width_amp_b_B_SPK_L"
	(constraint track_width (min 0.1843mm))
	(condition "A.NetName == '/amp_b/B_SPK_L-' && A.Type == 'track'")
)
(rule "aiee_pwr_width_amp_b_B_SPK_R"
	(constraint track_width (min 0.1843mm))
	(condition "A.NetName == '/amp_b/B_SPK_R+' && A.Type == 'track'")
)
(rule "aiee_pwr_width_amp_b_B_SPK_R"
	(constraint track_width (min 0.1843mm))
	(condition "A.NetName == '/amp_b/B_SPK_R-' && A.Type == 'track'")
)
(rule "aiee_pwr_width_rails_BUCK5_LX"
	(constraint track_width (min 0.5000mm))
	(condition "A.NetName == '/rails/BUCK5_LX' && A.Type == 'track'")
)
(rule "aiee_pwr_width_rails_BUCK3_LX"
	(constraint track_width (min 0.5000mm))
	(condition "A.NetName == '/rails/BUCK3_LX' && A.Type == 'track'")
)

# review-6 R6-m2 (repeat of R4-BAN-3 on Lite): the GND pour stood ~0.1 mm off the
# banana sockets' solder rings, a hand/wave-solder bridge from shorting a
# speaker leg to GND. 0.3 mm round each socket pad. rebuild_board.sh appends
# this after rules_gen.
(rule "banana_ring_to_gnd"
	(constraint clearance (min 0.3mm))
	(condition "(A.memberOfFootprint('J20') || A.memberOfFootprint('J21') || A.memberOfFootprint('J22') || A.memberOfFootprint('J23') || A.memberOfFootprint('J24') || A.memberOfFootprint('J25') || A.memberOfFootprint('J26') || A.memberOfFootprint('J27')) && A.Type == 'Pad' && B.Type == 'Zone' && B.NetName == 'GND'")
)
