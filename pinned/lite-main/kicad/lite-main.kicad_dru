(version 1)
# Generated by hwde rules_gen.py from constraints + jlc_capabilities.
# Baseline (fab floor) first, per-net design rules last (later rule wins).
(rule "aiee_track_width_floor"
	(constraint track_width (min 0.1270mm))
	(condition "A.Type == 'track'")
)
(rule "aiee_clearance_floor"
	(constraint clearance (min 0.1270mm))
)
(rule "aiee_via_drill_floor"
	(constraint hole_size (min 0.3000mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_via_diameter_floor"
	(constraint via_diameter (min 0.6000mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_annular_floor"
	(constraint annular_width (min 0.1500mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_edge_clearance_floor"
	(constraint edge_clearance (min 0.3000mm))
)
(rule "aiee_hole_to_hole_floor"
	(constraint hole_to_hole (min 0.5000mm))
)
(rule "aiee_silk_width_floor"
	(constraint text_thickness (min 0.1500mm))
	(condition "A.Type == 'text' && (A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen')")
)
(rule "aiee_pwr_width_VBUS"
	(constraint track_width (min 0.1474mm))
	(condition "A.NetName == 'VBUS' && A.Type == 'track'")
)
(rule "aiee_pwr_width_PVDD"
	(constraint track_width (min 0.2949mm))
	(condition "A.NetName == 'PVDD' && A.Type == 'track'")
)
(rule "aiee_pwr_width_GND"
	(constraint track_width (min 0.1843mm))
	(condition "A.NetName == 'GND' && A.Type == 'track'")
)
(rule "aiee_pwr_width_5V"
	(constraint track_width (min 0.4000mm))
	(condition "A.NetName == '+5V' && A.Type == 'track'")
)
(rule "aiee_pwr_width_3V3"
	(constraint track_width (min 0.1750mm))
	(condition "A.NetName == '+3V3' && A.Type == 'track'")
)
(rule "aiee_pwr_width_3V3A"
	(constraint track_width (min 0.0250mm))
	(condition "A.NetName == '+3V3A' && A.Type == 'track'")
)
(rule "aiee_pwr_width_OUT_R_P"
	(constraint track_width (min 0.3083mm))
	(condition "A.NetName == '/OUT_R_P' && A.Type == 'track'")
)
(rule "aiee_pwr_width_OUT_R_N"
	(constraint track_width (min 0.3083mm))
	(condition "A.NetName == '/OUT_R_N' && A.Type == 'track'")
)
(rule "aiee_pwr_width_OUT_L_P"
	(constraint track_width (min 0.3083mm))
	(condition "A.NetName == '/OUT_L_P' && A.Type == 'track'")
)
(rule "aiee_pwr_width_OUT_L_N"
	(constraint track_width (min 0.3083mm))
	(condition "A.NetName == '/OUT_L_N' && A.Type == 'track'")
)
(rule "aiee_pwr_width_SPK_L_P"
	(constraint track_width (min 1.2109mm))
	(condition "A.NetName == '/SPK_L_P' && A.Type == 'track'")
)
(rule "aiee_pwr_width_SPK_L_N"
	(constraint track_width (min 1.2109mm))
	(condition "A.NetName == '/SPK_L_N' && A.Type == 'track'")
)
(rule "aiee_pwr_width_SPK_R_P"
	(constraint track_width (min 1.2109mm))
	(condition "A.NetName == '/SPK_R_P' && A.Type == 'track'")
)
(rule "aiee_pwr_width_SPK_R_N"
	(constraint track_width (min 1.2109mm))
	(condition "A.NetName == '/SPK_R_N' && A.Type == 'track'")
)
(rule "aiee_pwr_width_BUCK5_SW"
	(constraint track_width (min 0.4000mm))
	(condition "A.NetName == '/BUCK5_SW' && A.Type == 'track'")
)
(rule "aiee_pwr_width_BUCK3_LX"
	(constraint track_width (min 0.5000mm))
	(condition "A.NetName == '/BUCK3_LX' && A.Type == 'track'")
)

# review-4 R4-BAN-3: the GND pour stood 0.127 mm off the banana sockets'
# solder rings, a hand/wave-solder bridge away from shorting a speaker
# output to GND; 0.3 mm round each socket pad (build.sh appends this after
# rules_gen)
(rule "banana_ring_to_gnd"
	(constraint clearance (min 0.3mm))
	(condition "(A.memberOfFootprint('J4') || A.memberOfFootprint('J5') || A.memberOfFootprint('J6') || A.memberOfFootprint('J7')) && A.Type == 'Pad' && B.Type == 'Zone' && B.NetName == 'GND'")
)
