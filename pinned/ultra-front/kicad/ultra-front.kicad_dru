(version 1)
# Generated by hwde rules_gen.py from constraints + jlc_capabilities.
# Baseline (fab floor) first, per-net design rules last (later rule wins).
(rule "aiee_track_width_floor"
	(constraint track_width (min 0.1270mm))
	(condition "A.Type == 'track'")
)
(rule "aiee_clearance_floor"
	(constraint clearance (min 0.1270mm))
)
(rule "aiee_via_drill_floor"
	(constraint hole_size (min 0.3000mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_via_diameter_floor"
	(constraint via_diameter (min 0.6000mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_annular_floor"
	(constraint annular_width (min 0.1500mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_edge_clearance_floor"
	(constraint edge_clearance (min 0.3000mm))
)
(rule "aiee_hole_to_hole_floor"
	(constraint hole_to_hole (min 0.5000mm))
)
(rule "aiee_silk_width_floor"
	(constraint text_thickness (min 0.1500mm))
	(condition "A.Type == 'text' && (A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen')")
)
(rule "aiee_pwr_width_5V"
	(constraint track_width (min 0.0500mm))
	(condition "A.NetName == '+5V' && A.Type == 'track'")
)
(rule "aiee_pwr_width_3V3"
	(constraint track_width (min 0.0250mm))
	(condition "A.NetName == '+3V3' && A.Type == 'track'")
)
(rule "aiee_pwr_width_BL_A"
	(constraint track_width (min 0.0400mm))
	(condition "A.NetName == '/BL_A' && A.Type == 'track'")
)
(rule "aiee_pwr_width_BL_K"
	(constraint track_width (min 0.0400mm))
	(condition "A.NetName == '/BL_K' && A.Type == 'track'")
)

# Board-local (ultra-front): the 0.5 mm FFC/FPC sockets' GND pins join the
# pours solid (thermal spokes cannot fit between 0.2 mm gaps), and the EC11's
# GND pins need only one resolved spoke. Appended after rules_gen; re-append
# if rules_gen is re-run.
(rule "aiee_local_fpc_gnd_solid"
	(condition "A.Type == 'Pad' && A.NetName == 'GND' && (A.Parent.Reference == 'J1' || A.Parent.Reference == 'J2')")
	(constraint zone_connection solid))
(rule "aiee_local_ec11_spokes"
	(condition "A.Type == 'Pad' && A.Parent.Reference == 'SW4'")
	(constraint min_resolved_spokes 1))
