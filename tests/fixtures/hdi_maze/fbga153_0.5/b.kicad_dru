(version 1)
# Generated by hwde rules_gen.py from constraints + jlc_capabilities.
# Baseline (fab floor) first, per-net design rules last (later rule wins).
(rule "aiee_track_width_floor"
	(constraint track_width (min 0.0889mm))
	(condition "A.Type == 'track'")
)
(rule "aiee_clearance_floor"
	(constraint clearance (min 0.0889mm))
)
(rule "aiee_via_drill_floor"
	(constraint hole_size (min 0.2000mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_via_diameter_floor"
	(constraint via_diameter (min 0.4500mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_annular_floor"
	(constraint annular_width (min 0.1000mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_edge_clearance_floor"
	(constraint edge_clearance (min 0.3000mm))
)
(rule "aiee_hole_to_hole_floor"
	(constraint hole_to_hole (min 0.5000mm))
)
(rule "aiee_silk_width_floor"
	(constraint text_thickness (min 0.1500mm))
	(condition "A.Type == 'text' && (A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen')")
)
(rule "aiee_hdi_micro_hole"
	(constraint hole_size (min 0.0750mm))
	(condition "A.Via_Type == 'Micro'")
)
(rule "aiee_hdi_micro_dia"
	(constraint via_diameter (min 0.2250mm))
	(condition "A.Via_Type == 'Micro'")
)
(rule "aiee_hdi_micro_ring"
	(constraint annular_width (min 0.0750mm))
	(condition "A.Via_Type == 'Micro'")
)
(rule "aiee_hdi_micro_hole_clearance"
	(constraint hole_clearance (min 0.1500mm))
	(condition "A.Via_Type == 'Micro' || B.Via_Type == 'Micro'")
)
(rule "aiee_hdi_micro_hole_to_hole"
	(constraint hole_to_hole (min 0.2400mm))
	(condition "A.Via_Type == 'Micro' || B.Via_Type == 'Micro'")
)
(rule "aiee_hdi_buried_hole"
	(constraint hole_size (min 0.1500mm))
	(condition "A.Via_Type == 'Buried'")
)
(rule "aiee_hdi_buried_dia"
	(constraint via_diameter (min 0.3000mm))
	(condition "A.Via_Type == 'Buried'")
)
(rule "aiee_hdi_buried_ring"
	(constraint annular_width (min 0.0750mm))
	(condition "A.Via_Type == 'Buried'")
)
(rule "aiee_hdi_buried_hole_clearance"
	(constraint hole_clearance (min 0.1500mm))
	(condition "A.Via_Type == 'Buried' || B.Via_Type == 'Buried'")
)
(rule "aiee_hdi_buried_hole_to_hole"
	(constraint hole_to_hole (min 0.2400mm))
	(condition "A.Via_Type == 'Buried' || B.Via_Type == 'Buried'")
)
(rule "aiee_bga_escape_U1"
	(constraint clearance (min 0.1250mm))
	(condition "A.intersectsCourtyard('U1') || B.intersectsCourtyard('U1')")
)
(rule "aiee_hdi_field_track_U1"
	(constraint track_width (min 0.0762mm))
	(condition "A.intersectsCourtyard('U1') || B.intersectsCourtyard('U1')")
)
(rule "aiee_hdi_field_clearance_U1"
	(constraint clearance (min 0.0762mm))
	(condition "A.intersectsCourtyard('U1') || B.intersectsCourtyard('U1')")
)
