(version 1)
# Generated by hwde rules_gen.py from constraints + jlc_capabilities.
# Baseline (fab floor) first, per-net design rules last (later rule wins).
(rule "aiee_pkg_rating_J1"
	(constraint clearance (min 0.2000mm))
	(condition "A.intersectsCourtyard('J1') && B.intersectsCourtyard('J1') && A.Type != 'Zone' && B.Type != 'Zone'")
)
