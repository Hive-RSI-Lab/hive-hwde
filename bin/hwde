#!/bin/sh
# hwde inside the Hive: finds the Hive's KiCad, freerouting and Java, keeps
# the skill's Python venv in the agent's own HOME, and runs the skill's
# scripts with the HWDE_* pins set (skill/scripts/lib/env.py reads them).
#
#   hwde env              print the exports (eval "$(hwde env)")
#   hwde check            the skill's check_env: every tool the pipeline needs
#   hwde test [args]      the skill's unit tests and the workaround probes,
#                         no KiCad runs of whole boards (the per-PR test)
#   hwde check-all        re-run every board's gates from a scratch copy, and
#                         check docs/workarounds.md against its probes (slow)
#   hwde score            the share of gate steps with no workaround (the score)
#   hwde publish <dir>    put a self-contained copy at <dir>/hwde (a warden
#                         runs it into the Hive's tools folder, so a check
#                         sandbox, which mounts only /work and /hive/tools,
#                         has /hive/tools/hwde/bin/hwde with no venv to build)
#                         A published copy hands each command to the
#                         installed module (/hive/modules/hive-hwde, which
#                         follows main at every merge) whenever it can see
#                         it and both pin the same requirements.lock, so
#                         only a lock change needs a new publish.
#   hwde <script> [args]  run skill/scripts/<script>.py with the venv python
#                         (or the published copy's own)
#
# A shim here that works around a defect in the skill runs only while its id
# is listed in docs/workarounds.md (wa <id>): delisting it turns it off.
#
# test, check-all and the scripts that run a whole board, the router or a sim
# wait for `hive agent heavy`'s lease inside a Hive turn (at most 10 minutes,
# then run anyway): give the shell command a timeout to match.
#
# Nothing here installs anything outside HOME but publish's <dir>: KiCad and
# freerouting are the Hive's (in its shared tools folder, put there through a
# warden); the venv is built from requirements.lock with the Hive's uv on
# first use. A published copy carries its own Python 3.14 with the packages
# installed in it, and uses that instead.
set -e
here=$(cd "$(dirname "$0")/.." && pwd)

# A published copy runs the installed module's code with its own python when
# the module is in sight (agents see $HIVE_MODULES; a check sees it once the
# Hive mounts it) and the two lock the same packages; else its own code.
if [ -f "$here/VERSION" ] && [ -z "${HWDE_PUBLISHED:-}" ]; then
	mod=${HIVE_MODULES:-/hive/modules}/hive-hwde
	if [ -x "$mod/bin/hwde" ] && [ ! -f "$mod/VERSION" ] && cmp -s "$mod/requirements.lock" "$here/requirements.lock"; then
		HWDE_PUBLISHED=$here exec "$mod/bin/hwde" "$@"
	fi
fi
pub=${HWDE_PUBLISHED:-$here}
tools=${HIVE_TOOLS:-/hive/tools}
state=${HWDE_HOME:-$HOME/.cache/hwde}
venv=${HWDE_VENV:-$state/venv}
finduv() {
	uv=$(command -v uv || true)
	[ -z "$uv" ] && [ -x "$tools/uv/bin/uv" ] && uv=$tools/uv/bin/uv
	[ -n "$uv" ] || { echo "hwde: needs uv (hive agent install --tool uv)" >&2; exit 127; }
}

# The score reads files only: no KiCad, no venv.
if [ "${1:-}" = score ]; then
	shift
	exec python3 "$here/bin/score.py" "$@"
fi

# publish builds the copy beside <dir>/hwde and swaps it in, so a check that
# is running keeps the old one whole. Its python is a python-build-standalone
# (relocatable: the host's path to the tools folder isn't /hive/tools), with
# no venv, whose symlinks and pyvenv.cfg would name the host's path.
if [ "${1:-}" = publish ]; then
	[ -n "${2:-}" ] && [ -d "$2" ] || { echo "usage: hwde publish <existing dir>" >&2; exit 2; }
	dest=$(cd "$2" && pwd)
	finduv
	ver=$(git -C "$here" rev-parse --short HEAD 2>/dev/null || date -u +%Y%m%d%H%M%S)
	new=$dest/.hwde-new-$$
	rm -rf "$new"
	trap 'rm -rf "$new"' EXIT
	mkdir -p "$new"
	(cd "$here" && tar cf - bin docs .claude/skills/hwde requirements.lock module.json LICENSE NOTICE README.md) | (cd "$new" && tar xf -)
	"$uv" python install -q --install-dir "$new/python" --no-bin 3.14 >&2
	find "$new/python" -maxdepth 1 -type l -exec rm {} + # absolute links to $new
	py=$(ls -d "$new"/python/cpython-3.14.*/bin/python3.14 | sort -V | tail -n 1)
	grep -v '^pywin32==' "$here/requirements.lock" >"$new/python/requirements.txt"
	"$uv" pip install -q --python "$py" --break-system-packages -r "$new/python/requirements.txt" >&2
	"$py" -c 'import kicad_sch_api, pytest' # the copy runs, or nothing is swapped
	# KiCad 10's flat symbol copies (see symdir below), made once here.
	appdir=$(ls -d "$tools"/kicad-10.* 2>/dev/null | sort -V | tail -n 1)
	if [ -n "$appdir" ] && [ -d "$appdir/share/kicad/symbols/power.kicad_symdir" ]; then
		"$py" "$here/bin/flatten-symdirs.py" "$appdir/share/kicad/symbols" "$new/symbols-$(basename "$appdir")"
	fi
	echo "$ver" >"$new/VERSION"
	rm -rf "$dest/.hwde-old"
	[ -d "$dest/hwde" ] && mv "$dest/hwde" "$dest/.hwde-old"
	mv "$new" "$dest/hwde"
	rm -rf "$dest/.hwde-old"
	echo "$ver" >"$dest/hwde.version"
	echo "hwde $ver published at $dest/hwde (run $dest/hwde/bin/hwde)"
	exit 0
fi
wa() { grep -q "^| *$1 *|" "$here/docs/workarounds.md" 2>/dev/null; }

# KiCad: an explicit pin wins; else the newest KiCad 10 AppDir in the tools
# folder, through wrappers that put kicad-cli and KiCad's own python (it has
# the SWIG pcbnew module) side by side, as env.find_kicad_python expects.
appdir=
if [ -z "${HWDE_KICAD_CLI:-}" ]; then
	appdir=$(ls -d "$tools"/kicad-10.* 2>/dev/null | sort -V | tail -n 1)
	if [ -n "$appdir" ] && [ -x "$appdir/AppRun" ]; then
		mkdir -p "$state/bin"
		printf '#!/bin/sh\nexec "%s/AppRun" kicad-cli "$@"\n' "$appdir" >"$state/bin/kicad-cli"
		chmod 0755 "$state/bin/kicad-cli"
		# The AppImage's python is bin/python3.11, run through sharun; pcbnew
		# is in its dist-packages.
		kpy=$(ls "$appdir"/bin/python3.* 2>/dev/null | sort -V | tail -n 1)
		if [ -n "$kpy" ]; then
			pyv=$(basename "$kpy")
			printf '#!/bin/sh\nexport PYTHONPATH="%s/shared/lib/%s/dist-packages${PYTHONPATH:+:$PYTHONPATH}"\nexec "%s/AppRun" %s "$@"\n' "$appdir" "$pyv" "$appdir" "$pyv" >"$state/bin/python3"
			chmod 0755 "$state/bin/python3"
		fi
		# render.py checks for KiCad's 3D model loaders at a distro path
		# beside the kicad-cli it runs; the AppImage keeps them in shared/lib.
		rm -f "$state/usr/lib/kicad/plugins/3d"
		if wa render-3d-loaders && [ -d "$appdir/shared/lib/kicad/plugins/3d" ]; then
			mkdir -p "$state/usr/lib/kicad/plugins"
			ln -sfn "$appdir/shared/lib/kicad/plugins/3d" "$state/usr/lib/kicad/plugins/3d"
		fi
		[ -f "$appdir/shared/lib/libngspice.so" ] && ln -sf "$appdir/shared/lib/libngspice.so" "$state/bin/libngspice.so"
		HWDE_KICAD_CLI=$state/bin/kicad-cli
	fi
fi
if [ -z "${HWDE_FREEROUTING_JAR:-}" ]; then
	jar=$(ls "$tools"/freerouting/freerouting-*.jar 2>/dev/null | sort -V | tail -n 1)
	[ -n "$jar" ] && HWDE_FREEROUTING_JAR=$jar
fi
[ -z "${HWDE_JAVA:-}" ] && command -v java >/dev/null 2>&1 && HWDE_JAVA=$(command -v java)
# The knowledge records cite manufacturers' PDFs the module doesn't carry
# (NOTICE); the hwde project's clone has them.
if [ -z "${HWDE_KNOWLEDGE_SOURCES:-}" ]; then
	src=${HIVE_PROJECTS:-/hive/projects}/hwde/.claude/skills/hwde/reference/knowledge/sources
	[ -d "$src" ] && HWDE_KNOWLEDGE_SOURCES=$src
fi
# Boards live in the project the agent works in, under boards/.
HWDE_BOARDS_ROOT=${HWDE_BOARDS_ROOT:-$PWD/boards}

# A published copy's own python (an explicit HWDE_VENV still wins); else the
# venv in HOME, built when missing or older than the lock.
py=
[ -z "${HWDE_VENV:-}" ] && py=$(ls -d "$pub"/python/cpython-3.14.*/bin/python3.14 2>/dev/null | sort -V | tail -n 1)
own=$py
[ -n "$py" ] || py=$venv/bin/python
if [ -z "$own" ] && { [ ! -x "$py" ] || [ "$here/requirements.lock" -nt "$venv/.hwde-lock" ]; }; then
	finduv
	mkdir -p "$state"
	grep -v '^pywin32==' "$here/requirements.lock" >"$state/requirements.txt"
	"$uv" venv -q --clear --python 3.14 "$venv" >&2
	VIRTUAL_ENV=$venv "$uv" pip install -q -r "$state/requirements.txt" >&2
	touch "$venv/.hwde-lock"
fi

# KiCad 10 ships its stock symbols as one-file-per-symbol .kicad_symdir
# folders, which kicad-sch-api (the skill's schematic writer) can't read; it
# gets flat copies of the libraries the skill places by lib_id (power, Device).
if wa symdir && [ -n "$appdir" ] && [ -z "${KICAD_SYMBOL_DIR:-}" ] && [ -d "$appdir/share/kicad/symbols/power.kicad_symdir" ]; then
	syms=$pub/symbols-$(basename "$appdir")
	[ -f "$syms/power.kicad_sym" ] || syms=$state/symbols-$(basename "$appdir")
	[ -f "$syms/power.kicad_sym" ] || "$py" "$here/bin/flatten-symdirs.py" "$appdir/share/kicad/symbols" "$syms"
	export KICAD_SYMBOL_DIR=$syms
fi

# HWDE_PY lets a script tell the runner's venv from another python (partslib's hint).
export HWDE_PY="$py"
export HWDE_KICAD_CLI HWDE_FREEROUTING_JAR HWDE_JAVA HWDE_KNOWLEDGE_SOURCES HWDE_BOARDS_ROOT
[ -n "${HWDE_KICAD_CLI:-}" ] || unset HWDE_KICAD_CLI
[ -n "${HWDE_FREEROUTING_JAR:-}" ] || unset HWDE_FREEROUTING_JAR
[ -n "${HWDE_JAVA:-}" ] || unset HWDE_JAVA
[ -n "${HWDE_KNOWLEDGE_SOURCES:-}" ] || unset HWDE_KNOWLEDGE_SOURCES
[ -f "$state/bin/libngspice.so" ] && export HWDE_NGSPICE_DLL="$state/bin/libngspice.so"
# KiCad's SWIG paths need an X display: with none, a script runs under its own
# Xvfb (xvfb-run), gone when the script ends. GLX stays off: H0's Xvfb crashes
# loading it through the NVIDIA EGL libraries, and KiCad doesn't need it here.
xvfb=
[ -z "${DISPLAY:-}" ] && command -v xvfb-run >/dev/null 2>&1 && xvfb=1
# A heavy command (a pytest suite, the router, whole-board gates) runs under
# `hive agent heavy`, which waits while the machine is strained and others
# run one: on 10-28 ten hwde suites and freerouting at once took a 20-core
# load to 137. Not when it is already inside one (check-all's gates, a test
# that runs hwde) or the hive at hand has no heavy op yet: then it runs bare.
heavy=
lease() {
	[ -n "$heavy" ] && [ -z "${HWDE_HEAVY_HELD:-}" ] && command -v hive >/dev/null 2>&1 &&
		hive agent help 2>/dev/null | grep -q '^  heavy '
}
x() {
	[ -n "$xvfb" ] && set -- xvfb-run -a -s "-extension GLX" "$@"
	if lease; then
		export HWDE_HEAVY_HELD=1
		exec hive agent heavy --what "$heavy" -- "$@"
	fi
	[ -n "$heavy" ] && export HWDE_HEAVY_HELD=1
	exec "$@"
}

case "${1:-}" in
env)
	for v in HWDE_KICAD_CLI HWDE_FREEROUTING_JAR HWDE_JAVA HWDE_KNOWLEDGE_SOURCES HWDE_BOARDS_ROOT HWDE_NGSPICE_DLL KICAD_SYMBOL_DIR; do
		eval "val=\${$v:-}"
		[ -n "$val" ] && printf "export %s='%s'\n" "$v" "$val"
	done
	printf "export HWDE_SKILL='%s'\nexport HWDE_PY='%s'\n" "$here/.claude/skills/hwde" "$py"
	;;
test)
	# tests/: upstream's unit tests (no smoke or net marks: those need a live
	# KiCad run or the internet) and test_workarounds.py, the probes. Boards
	# root is an empty scratch dir, so a test that wants a real board skips;
	# whole boards are check-all's.
	shift
	export HWDE_BIN="$here/bin/hwde" HWDE_APPDIR="$appdir" HWDE_STATE="$state"
	HWDE_BOARDS_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/hwde-noboards-XXXXXX")
	cd "$here"
	heavy="hwde test (the module's pytest suite)"
	x "$py" -m pytest -m "not smoke and not net" "$@"
	;;
check-all)
	shift
	export HWDE_BIN="$here/bin/hwde" HWDE_APPDIR="$appdir" HWDE_STATE="$state"
	heavy="hwde check-all (every board's gates)"
	x "$py" "$here/bin/check_all.py" "$@"
	;;
check)
	shift
	x "$py" "$here/.claude/skills/hwde/scripts/check_env.py" "$@"
	;;
"" | -h | --help)
	sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
	;;
*)
	s=${1%.py}
	shift
	# The scripts that run KiCad over a whole board, the router or a sim.
	case $s in
	route_auto | route_critical | place_anneal | gate | verify_all | bench | render | sim_run | fab_export)
		heavy="hwde $s" ;;
	esac
	x "$py" "$here/.claude/skills/hwde/scripts/$s.py" "$@"
	;;
esac
